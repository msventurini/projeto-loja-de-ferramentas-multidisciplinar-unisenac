        ...
    
    @property
    def warnings(self) -> Optional[List[WarningType]]:
        """Gets warnings."""
        ...
    
    @deprecated(DEPRECATED_METHOD_WARNING.format(property_name="warnings"))
    def fetchwarnings(self) -> Optional[List[WarningType]]:
        """Returns Warnings."""
        ...
    
    @property
    def warning_count(self) -> int:
